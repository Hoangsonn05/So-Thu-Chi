<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="40dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_ai_drag_handle" />

    <!-- AI Premium Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_ai_sparkle"
            android:background="@drawable/bg_ai_header_icon"
            android:padding="8dp"
            android:layout_marginEnd="14dp"
            android:elevation="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trợ Lý AI Thông Minh"
                android:textColor="#1A1A2E"
                android:textSize="22sp"
                android:letterSpacing="-0.01"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tự động ghi chép chi tiêu của bạn"
                android:textColor="#777777"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Fullscreen Toggle Button -->
        <ImageView
            android:id="@+id/btn_ai_expand_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_crop"
            android:tint="#7C4DFF"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Suggestion Chips - Larger Labels -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gợi ý nhanh:"
        android:textColor="#999999"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_ai_1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_ai_chip"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:layout_marginEnd="10dp"
                android:text="🍜 Phở sáng 45k"
                android:textColor="#444444"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_ai_2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_ai_chip"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:layout_marginEnd="10dp"
                android:text="☕ Cà phê 35k"
                android:textColor="#444444"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_ai_3"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_ai_chip"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:layout_marginEnd="10dp"
                android:text="🚌 Đi buýt 7k"
                android:textColor="#444444"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Input Box with Modern Shadow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ai_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/input_ai_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Hôm nay bạn đã chi tiêu gì?..."
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:minHeight="56dp"
            android:paddingHorizontal="12dp"
            android:textColor="#1A1A2E"
            android:textColorHint="#999999"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btn_voice_input"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_ai_voice_button"
            android:padding="11dp"
            android:src="@drawable/ic_mic"
            android:clickable="true"
            android:focusable="true"
            android:elevation="1dp" />

        <ImageView
            android:id="@+id/btn_ai_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_ai_send_button"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:clickable="true"
            android:focusable="true"
            android:elevation="1dp" />
    </LinearLayout>

    <!-- Status Text with animated feel -->
    <TextView
        android:id="@+id/tv_ai_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#7C4DFF"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone"
        android:text="✨ Đang phân tích yêu cầu của bạn..." />

</LinearLayout>

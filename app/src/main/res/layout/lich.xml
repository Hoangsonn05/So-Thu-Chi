<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Header Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lich_title"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/desc_search"
            android:src="@android:drawable/ic_menu_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_green" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Month Selector -->
    <LinearLayout
        android:id="@+id/month_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/header_toolbar">

        <ImageView
            android:id="@+id/btn_prev_month_lich"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/desc_prev"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/gray_text" />

        <LinearLayout
            android:id="@+id/date_container_lich"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_month_year_lich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/month_year_placeholder"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_month_range_lich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/month_range_placeholder"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_next_month_lich"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/desc_next"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/gray_text" />
    </LinearLayout>

    <!-- Calendar Grid with RecyclerView -->
    <LinearLayout
        android:id="@+id/calendar_grid_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@id/month_selector">

        <!-- Weekdays Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@color/calendar_header"
            android:orientation="horizontal">
            <TextView style="@style/CalendarHeaderStyle" android:text="@string/cn" android:textColor="@color/sunday_red" />
            <TextView style="@style/CalendarHeaderStyle" android:text="@string/t2" />
            <TextView style="@style/CalendarHeaderStyle" android:text="@string/t3" />
            <TextView style="@style/CalendarHeaderStyle" android:text="@string/t4" />
            <TextView style="@style/CalendarHeaderStyle" android:text="@string/t5" />
            <TextView style="@style/CalendarHeaderStyle" android:text="@string/t6" />
            <TextView style="@style/CalendarHeaderStyle" android:text="@string/t7" android:textColor="@color/saturday_blue" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="7" />
    </LinearLayout>

    <!-- Summary Row -->
    <LinearLayout
        android:id="@+id/summary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/calendar_grid_container">

        <LinearLayout style="@style/SummaryColumnStyle"
            android:id="@+id/summary_column1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/thu_nhap" android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_month_total_income"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_vnd" android:textColor="@color/primary_green" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/SummaryColumnStyle"
            android:id="@+id/summary_column2">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chi_tieu" android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_month_total_expense"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zero_vnd" android:textColor="@color/sunday_red" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/SummaryColumnStyle"
            android:id="@+id/summary_column3">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tong" android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_month_balance"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plus_zero_vnd" android:textColor="@color/black" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/summary_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"
        app:layout_constraintTop_toBottomOf="@id/summary_row" />

    <!-- History RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@id/summary_divider" />

    <!-- Floating Action Button cho Trợ lý AI -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#7C4DFF"
        android:src="@drawable/ic_ai_sparkle"
        android:contentDescription="Trợ lý AI"
        app:elevation="8dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FAFAFA"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/nav_nhap_vao"
            style="@style/BottomNavTabStyle"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIconStyle" android:contentDescription="@string/desc_tab" android:src="@android:drawable/ic_menu_edit" app:tint="@color/gray_text" />
            <TextView style="@style/BottomNavTextStyle" android:text="@string/nhap_vao" android:textColor="@color/gray_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_lich"
            style="@style/BottomNavTabStyle"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIconStyle" android:contentDescription="@string/desc_tab" android:src="@android:drawable/ic_menu_my_calendar" app:tint="@color/primary_green" />
            <TextView style="@style/BottomNavTextStyle" android:text="@string/lich" android:textColor="@color/primary_green" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_bao_cao"
            style="@style/BottomNavTabStyle"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIconStyle" android:contentDescription="@string/desc_tab" android:src="@android:drawable/ic_menu_report_image" app:tint="@color/gray_text" />
            <TextView style="@style/BottomNavTextStyle" android:text="@string/bao_cao" android:textColor="@color/gray_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_ngan_sach"
            style="@style/BottomNavTabStyle"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIconStyle" android:contentDescription="@string/desc_tab" android:src="@android:drawable/ic_menu_save" app:tint="@color/gray_text" />
            <TextView style="@style/BottomNavTextStyle" android:text="@string/ngan_sach" android:textColor="@color/gray_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_khac"
            style="@style/BottomNavTabStyle"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/BottomNavIconStyle" android:contentDescription="@string/desc_tab" android:src="@android:drawable/ic_menu_more" app:tint="@color/gray_text" />
            <TextView style="@style/BottomNavTextStyle" android:text="@string/khac" android:textColor="@color/gray_text" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
